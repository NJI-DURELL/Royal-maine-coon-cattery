# Royal Maine Coon Cattery — environment variables
# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
# Keys prefixed with NEXT_PUBLIC_ are exposed to the browser — never put secrets there.

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Public base URL of the site (used for metadata, canonicals, sitemap, referral links).
# Set to your production domain on Vercel, e.g. https://royalmainecoon.com
NEXT_PUBLIC_SITE_URL="https://royal-maine-coon-cattery.vercel.app"
# Public contact email shown on the site (optional; falls back to a default).
NEXT_PUBLIC_CONTACT_EMAIL=""

# ----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ----------------------------------------------------------------------------
# Full Postgres connection string. For `prisma db push`/migrations use a DIRECT
# (non-pooled) connection; for serverless runtime a pooled URL is fine.
DATABASE_URL=""

# ----------------------------------------------------------------------------
# Supabase (authentication)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Full admin access to Supabase — keep secret, never expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------------------
# AWS S3 (kitten image / proof uploads via presigned URLs)
# ----------------------------------------------------------------------------
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Public region value if referenced client-side (optional; mirror of AWS_REGION).
NEXT_PUBLIC_AWS_REGION=""

# ----------------------------------------------------------------------------
# Email (Resend) — notifications are currently stubbed/TODO in code
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM=""
BREEDER_EMAIL=""

# ----------------------------------------------------------------------------
# Integrations
# ----------------------------------------------------------------------------
# Calendly embed URL for the verified-buyer video-call booking widget.
# NOTE: the code reads NEXT_PUBLIC_CALENDLY_EMBED_URL (browser-exposed).
NEXT_PUBLIC_CALENDLY_EMBED_URL=""

# ----------------------------------------------------------------------------
# Referral program
# ----------------------------------------------------------------------------
# Reward amount (USD) granted per qualified referral. Defaults to 150 if unset.
NEXT_PUBLIC_REFERRAL_REWARD="150"

# ----------------------------------------------------------------------------
# Seed admin (used only by `npm run prisma:seed`)
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@royalmainecoon.test"
SEED_ADMIN_NAME="Royal Maine Coon Admin"
# Use a strong password — the seed creates a real Supabase auth user with this.
SEED_ADMIN_PASSWORD=""
